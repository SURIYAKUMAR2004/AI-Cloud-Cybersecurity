import pandas as pd


SUSPICIOUS_IPS = {
    "45.155.205.10",
    "103.27.186.20",
    "185.220.101.5"
}

PRIVILEGED_ACTIONS = {
    "AssumeRole",
    "CreateUser",
    "ChangePassword",
    "DeleteObject"
}


def correlate_attack_chain(df):

    df = df.copy()

    df["timestamp"] = pd.to_datetime(
        df["timestamp"],
        format="mixed"
    )

    df = df.sort_values(
        "timestamp"
    )

    incidents = []

    # Analyze each user independently
    for user, events in df.groupby("user"):

        events = events.sort_values(
            "timestamp"
        ).reset_index(drop=True)

        i = 0

        while i < len(events):

            start_time = events.loc[
                i, "timestamp"
            ]

            end_time = (
                start_time
                + pd.Timedelta(minutes=10)
            )

            window = events[
                (events["timestamp"] >= start_time)
                &
                (events["timestamp"] <= end_time)
            ]

            if len(window) == 0:
                i += 1
                continue

            failed = (
                window["status"] == "Failed"
            ).any()

            privileged = (
                window["action"]
                .isin(PRIVILEGED_ACTIONS)
            ).any()

            suspicious_ip = (
                window["source_ip"]
                .isin(SUSPICIOUS_IPS)
            ).any()

            large_transfer = (
                window["bytes_transferred"] > 50000
            ).any()

            score = 0
            reasons = []

            if failed:
                score += 20
                reasons.append(
                    "Failed operation"
                )

            if privileged:
                score += 30
                reasons.append(
                    "Privileged cloud operation"
                )

            if suspicious_ip:
                score += 30
                reasons.append(
                    "Suspicious external source"
                )

            if large_transfer:
                score += 20
                reasons.append(
                    "Large data transfer"
                )

            score = min(score, 100)

            # Only create an incident when
            # multiple indicators are present.
            if score >= 60:

                if score >= 80:
                    severity = "CRITICAL"
                else:
                    severity = "HIGH"

                # Determine attack assessment
                if (
                    privileged
                    and suspicious_ip
                    and large_transfer
                ):
                    assessment = (
                        "POSSIBLE_ACCOUNT_COMPROMISE"
                    )

                elif (
                    suspicious_ip
                    and large_transfer
                ):
                    assessment = (
                        "POSSIBLE_DATA_EXFILTRATION"
                    )

                elif privileged:
                    assessment = (
                        "SUSPICIOUS_PRIVILEGED_ACTIVITY"
                    )

                else:
                    assessment = (
                        "SUSPICIOUS_ACTIVITY"
                    )

            incidents.append({
    "user": user,
    "source_ip": window["source_ip"].iloc[0],
    "start_time": start_time,
    "end_time": window["timestamp"].max(),
                     "chain_score": score,
                    "severity": severity,
                    "assessment": assessment,
                    "attack_pattern": " → ".join(
                        reasons
                    ),
                    "events_correlated": len(window)
                })

                # Skip all events belonging
                # to this incident window.
                future_events = events[
                    events["timestamp"] > end_time
                ]

                if len(future_events) == 0:
                    break

                next_time = future_events[
                    "timestamp"
                ].min()

                next_positions = events.index[
                    events["timestamp"] == next_time
                ]

                if len(next_positions) > 0:
                    i = next_positions[0]
                else:
                    i += 1

            else:
                i += 1

    if not incidents:

        return pd.DataFrame(
            columns=[
                "user",
                "start_time",
                "end_time",
                "chain_score",
                "severity",
                "assessment",
                "attack_pattern",
                "events_correlated"
            ]
        )

    incidents_df = pd.DataFrame(
        incidents
    )

    return incidents_df.sort_values(
        "chain_score",
        ascending=False
    ).reset_index(drop=True)


if __name__ == "__main__":

    print(
        "\n===== CORRELATED SECURITY INCIDENTS =====\n"
    )

    df = pd.read_csv(
        "data/live_events.csv"
    )

    incidents = correlate_attack_chain(
        df
    )

    if incidents.empty:

        print(
            "No correlated security incidents detected."
        )

    else:

        for number, incident in enumerate(
            incidents.to_dict("records"),
            start=1
        ):

            print(
                f"\n🚨 INCIDENT #{number}"
            )

            print(
                f"User: {incident['user']}"
            )

            print(
                f"Start: {incident['start_time']}"
            )

            print(
                f"End: {incident['end_time']}"
            )

            print(
                f"Score: {incident['chain_score']}"
            )

            print(
                f"Severity: {incident['severity']}"
            )

            print(
                f"Assessment: {incident['assessment']}"
            )

            print(
                f"Events correlated: "
                f"{incident['events_correlated']}"
            )

            print(
                "Attack chain:"
            )

            print(
                incident["attack_pattern"]
            )

    print(
        "\n=========================================="
    )
